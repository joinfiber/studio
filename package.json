{
	"name": "studio",
	"version": "0.3.0",
	"private": true,
	"engines": {
		"node": ">=20.19"
	},
	"description": "Open-source operator GUI for the Neighborhood Commons — ingest, review, and publish neighborhood event and venue data.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/joinfiber/studio.git"
	},
	"type": "module",
	"packageManager": "pnpm@10.23.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build/index.js",
		"test": "vitest",
		"test:run": "vitest run",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@libsql/client": "^0.15.15",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.61.1",
		"fast-xml-parser": "^5.8.0",
		"maplibre-gl": "^5.24.0",
		"marked": "^18.0.4",
		"neighborhood-commons": "^3.2.0",
		"otplib": "^12.0.1",
		"qrcode": "^1.5.4",
		"svelte": "^5.55.10"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@types/node": "^25.9.1",
		"@types/qrcode": "^1.5.6",
		"openapi-fetch": "^0.14.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte-check": "^4.4.8",
		"typescript": "^5.9.3",
		"vite": "^8.0.14",
		"vitest": "^4.1.7"
	}
}
