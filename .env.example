# --- Commons connection -----------------------------------------------------
# The one thing Studio needs to do anything. Register a free key at
# neighborhood-commons.org/developers. Studio ships none — bring your own.
COMMONS_SERVICE_KEY=

# Your contributor handle from the developer dashboard. Recommended: lets
# readers see "via you" and loads your profile card in Settings. (There's no
# GET /me endpoint yet, so the slug is set explicitly.)
COMMONS_CONTRIBUTOR_SLUG=

# Commons API base. Defaults to the canonical instance (the SDK default);
# override only if you point at a non-canonical deployment.
# COMMONS_BASE_URL=https://neighborhood-commons.org/api/v1

# --- Access gate ------------------------------------------------------------
# REQUIRED on any public deployment. Studio holds your Commons key, so without
# a password anyone who reaches the URL can use it. Leave unset for local dev
# (the gate is off on localhost; the server logs a loud warning if a public
# deploy is missing it).
STUDIO_PASSWORD=
# Optional — signs the session cookie. Falls back to STUDIO_PASSWORD if unset.
SESSION_SECRET=
# Optional TOTP second factor. Enroll at /enroll (the secret is shown once),
# then set it here and redeploy. Login then requires a 6-digit code.
STUDIO_TOTP_SECRET=

# --- AI extraction (optional) -----------------------------------------------
# Unlocks the Paste-text and Scrape sources — pull events out of unstructured
# text. Bring your own inference key; Studio ships none. OpenAI-compatible.
INFERENCE_API_KEY=
# Endpoint + model default to Llama 3.1 8B on DeepInfra. Set these to use
# OpenAI, Together, Groq, a local model, etc. Your key must match the provider.
# INFERENCE_API_URL=https://api.deepinfra.com/v1/openai
# INFERENCE_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo

# --- Geocoding (optional) ---------------------------------------------------
# Manual Place publishing geocodes the address to coordinates. Defaults to
# OpenStreetMap's public Nominatim (no key; light use only, ~1 req/s). Point at
# a self-hosted Nominatim or a Nominatim-compatible host (e.g. LocationIQ) for
# volume; add a key if it needs one.
# GEOCODER_API_URL=https://nominatim.openstreetmap.org
# GEOCODER_API_KEY=

# --- Venue identity (optional) ----------------------------------------------
# Attach a Google Place ID when publishing places, so the same venue from
# different contributors dedups to one record. Studio requests ONLY the
# place_id (the one field Google's terms permit storing) — all venue facts
# (categories, address, hours) come from OpenStreetMap, never Google.
# GOOGLE_PLACES_API_KEY=

# --- Map (optional) ---------------------------------------------------------
# Basemap tiles for the Map tab. A free MapTiler key (maptiler.com), used in
# the browser — restrict it to your domain in the MapTiler dashboard. The map
# data (venues, and OpenStreetMap businesses) comes from the Commons + OSM;
# this is only the background map.
# MAPTILER_API_KEY=

# --- Community submissions (optional) ---------------------------------------
# Moderate user-generated events submitted through an app you operate, and
# publish the ones you approve. Leave unset if you don't run a submission
# source. See src/lib/tools/submissions/README.md for the expected contract.
# Base URL of the app whose submission queue you moderate.
SUBMISSIONS_API_URL=
# Shared secret that authenticates Studio to that app.
SUBMISSIONS_API_KEY=

# --- Server -----------------------------------------------------------------
PORT=3000
# Local SQLite for staging candidates + the map review overlay. Defaults to
# in-memory (lost on restart). Attach a volume and point this at it for
# persistence. NOT named DATABASE_URL — that's Railway's reserved Postgres var,
# and a postgres URL isn't a valid libsql target.
# STUDIO_DATABASE_URL=file:/data/studio.db

# --- Advanced / deployment-specific -----------------------------------------
# Admin-key flag. Set true ONLY if your Commons key has is_admin=true. With a
# standard key (the default), leave false — writes are scoped to organizations
# you're linked to, and setting true without an admin key causes 403s.
COMMONS_IS_ADMIN=false
# Overpass endpoint for the bulk venue importer. Defaults to the public
# OpenStreetMap Overpass API; set a self-hosted instance for volume.
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter
